{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskal 3",
  "version": "3.2.1",
  "identifier": "il.taskal.app3",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Taskal 3",
        "hiddenTitle": true,
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "backgroundColor": "#1f3a63"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
